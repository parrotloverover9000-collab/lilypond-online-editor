\version "2.24.4"
\score {
  \new StaffGroup <<
    % Woodwinds
    \new Staff \with { instrumentName = "Flute 1" } { \key a \major \time 4/4 \partial 4 \repeat volta 2 { a4 b8 c d e4 r4 } }
    \new Staff \with { instrumentName = "Flute 2" } { \key a \major \time 4/4 \partial 4 \repeat volta 2 { e4 fis8 g a b4 r4 } }
    \new Staff \with { instrumentName = "Flute 3" } { %% unison or harmony part
      \key a \major \time 4/4 \partial 4 \repeat volta 2 { a4 b8 c d e4 r4 }
    }
    \new Staff \with { instrumentName = "Flute 4" } { \key a \major \time 4/4 \partial 4 \repeat volta 2 { e4 fis8 g a b4 r4 } }
    \new Staff \with { instrumentName = "Clarinet 1" } { \clef treble \key a \major \time 4/4 \partial 4 \repeat volta 2 { e2 fis4 } }
    \new Staff \with { instrumentName = "Clarinet 2" } { \clef treble \key a \major \time 4/4 \partial 4 \repeat volta 2 { cis2 e4 } }
    \new Staff \with { instrumentName = "Clarinet 3" } { \clef treble \key a \major \time 4/4 \partial 4 \repeat volta 2 { a2 fis4 } }
    % Alto Sax
    \new Staff \with { instrumentName = "Alto Sax" } { \clef treble \key a \major \time 4/4 \partial 4 \repeat volta 2 { a2 b4 } }
    % Tenor Sax
    \new Staff \with { instrumentName = "Tenor Sax" } { \clef treble \key a \major \time 4/4 \partial 4 \repeat volta 2 { cis2 e4 } }
    % Bari Sax
    \new Staff \with { instrumentName = "Bari Sax" } { \clef bass \key a \major \time 4/4 \partial 4 \repeat volta 2 { a2 fis4 } }
    % Brass
    \new Staff \with { instrumentName = "Trumpet 1" } { \clef treble \key a \major \time 4/4 \partial 4 \repeat volta 2 { a4 b8 c d e2 } }
    \new Staff \with { instrumentName = "Trumpet 2" } { \clef treble \key a \major \time 4/4 \partial 4 \repeat volta 2 { a4 g8 fis e d2 } }
    \new Staff \with { instrumentName = "Trumpet 3" } { \clef treble \key a \major \time 4/4 \partial 4 \repeat volta 2 { e4 d8 c b a2 } }
    \new Staff \with { instrumentName = "Mellophone" } { \clef treble \key a \major \time 4/4 \partial 4 \repeat volta 2 { cis2 e4 } }
    \new Staff \with { instrumentName = "Trombone 1" } { \clef bass \key a \major \time 4/4 \partial 4 \repeat volta 2 { a2 e4 } }
    \new Staff \with { instrumentName = "Trombone 2" } { \clef bass \key a \major \time 4/4 \partial 4 \repeat volta 2 { fis2 a4 } }
    \new Staff \with { instrumentName = "Baritone 1" } { \clef bass \key a \major \time 4/4 \partial 4 \repeat volta 2 { cis2 a4 } }
    \new Staff \with { instrumentName = "Baritone 2" } { \clef bass \key a \major \time 4/4 \partial 4 \repeat volta 2 { a2 fis4 } }
    \new Staff \with { instrumentName = "Tuba" } { \clef bass \key a \major \time 4/4 \partial 4 \repeat volta 2 { a2 a4 } }
    % Percussion
    \new DrumStaff {
      \set DrumStaff.drumStyleTable = #alist< 'bassdrum1 . bassdrum 'snare . snare 'tom . tomtom >
      \drummode {
        bd sn bd sn |
        bd sn bd sn |
      }
    }
  >>
  \layout { ragged-right = ##t }
  \midi { }
}
